<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practica1.MainPage"
             BackgroundColor="#58255C">

    <Shell.TitleView>
        <HorizontalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center">
        </HorizontalStackLayout>
            
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout
                Padding="30,0"
                Spacing="25">
            <Image
                Source="sun_moon.png"
                HeightRequest="100"
                Aspect="AspectFit"
                SemanticProperties.Description="sun and moon cycle" />

            <Label
                Text="TicTacToe"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Border
                BackgroundColor="{StaticResource PanelBackground}"
                Stroke="Gray"
                StrokeThickness="3"
                Padding="10"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="350">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <!-- tablero -->
                <Grid
                    RowSpacing="6"
                    ColumnSpacing="6"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <!-- Row 0 -->
                    <Image
                        Source="sunshine.png"
                        HeightRequest="50"
                        Aspect="AspectFit"
                        SemanticProperties.Description="Sun" />
                    <Image
                        Grid.Column="1"
                        Source="left_arrow.png"
                        HeightRequest="50"
                        Aspect="AspectFit"
                        SemanticProperties.Description="Arrow" />
                    <Image
                        Grid.Column="2"
                        Source="planet.png"
                        HeightRequest="50"
                        Aspect="AspectFit"
                        SemanticProperties.Description="Moon" />
                    <!-- Row 1 -->
                    <BoxView
            Grid.Row="1"
            Color="{StaticResource TileBackground2}"
            CornerRadius="10"/>
                    <BoxView
            Grid.Row="1"
            Grid.Column="1"
            Color="{StaticResource TileBackground1}"
            CornerRadius="10"/>
                    <BoxView
            Grid.Row="1"
            Grid.Column="2"
            Color="{StaticResource TileBackground2}"
            CornerRadius="10"/>
                </Grid>
            </Border>
            <Border
                BackgroundColor="{StaticResource PanelBackground}"
                Stroke="Gray"
                StrokeThickness="3"
                Padding="10"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HeightRequest="350"
                WidthRequest="350"
                >

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <!-- tablero -->
                <Grid
                        RowSpacing="6"
                        ColumnSpacing="6"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100" />
                        <RowDefinition Height="100" />
                        <RowDefinition Height="100"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <!-- Row 0 -->
                    <BoxView
                        Color="{StaticResource TileBackground1}"
                        CornerRadius="10"/>
                    <BoxView
                        Grid.Column="1"
                        Color="{StaticResource TileBackground2}"
                        CornerRadius="10"/>
                    <BoxView
                        Grid.Column="2"
                        Color="{StaticResource TileBackground1}"
                        CornerRadius="10"/>
                    <!-- Row 1 -->
                    <BoxView
                        Grid.Row="1"
                        Color="{StaticResource TileBackground2}"
                        CornerRadius="10"/>
                    <BoxView
                        Grid.Row="1"
                        Grid.Column="1"
                        Color="{StaticResource TileBackground1}"
                        CornerRadius="10"/>
                    <BoxView
                        Grid.Row="1"
                        Grid.Column="2"
                        Color="{StaticResource TileBackground2}"
                        CornerRadius="10"/>
                    <!-- Row 2 -->
                    <BoxView
                        Grid.Row="2"
                        Color="{StaticResource TileBackground1}"
                        CornerRadius="10"/>
                    <BoxView
                        Grid.Row="2"
                        Grid.Column="1"
                        Color="{StaticResource TileBackground2}"
                        CornerRadius="10"/>
                    <BoxView
                        Grid.Row="2"
                        Grid.Column="2"
                        Color="{StaticResource TileBackground1}"
                        CornerRadius="10"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
